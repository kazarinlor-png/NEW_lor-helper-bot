[Unit]
Description=LOR Помощник Telegram Bot
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/lor-bot

# Запуск бота
ExecStart=/usr/bin/docker-compose up -d
ExecStop=/usr/bin/docker-compose down
ExecReload=/usr/bin/docker-compose restart

# Проверка здоровья
ExecStartPost=/usr/bin/docker-compose ps bot | grep -q "Up"
TimeoutStartSec=300
TimeoutStopSec=60

# Перезапуск при сбоях
Restart=on-failure
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
